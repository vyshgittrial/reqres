  "item": [
    {
      "name": "Createusersrandom",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "756c4acf-40c7-4668-8650-9715f3d6df4a",
            "exec": [
              "pm.collectionVariables.set(\"baseURL\", \"https://gorest.co.in/public/v3\");\r",
              "pm.collectionVariables.set(\"token\", \"gorest_8MzzKdG8TQD8xKYCidZi0LWAaU2FLkH0uRRxX94GmPQ0YTk42\");\r",
              "// Generate a random number suffix to ensure uniqueness\r",
              "const randomSuffix = Math.floor(Math.random() * 100000);\r",
              "\r",
              "// Define your desired prefixes\r",
              "const namePrefix = \"do\";\r",
              "const emailPrefix = \"code\";\r",
              "\r",
              "// Combine the prefix with the random suffix\r",
              "const finalName = namePrefix + randomSuffix;\r",
              "const finalEmail = emailPrefix + randomSuffix + \"@rest.co.in\";\r",
              "\r",
              "// Save them as collection variables\r",
              "pm.collectionVariables.set(\"random_name\", finalName);\r",
              "pm.collectionVariables.set(\"random_email\", finalEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "c8ccf700-7864-4dba-ad4e-96cc80d72dca",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"response time is less than 1000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "var responseJson = pm.response.json();\r",
              "const schema = {\r",
              "  type: \"object\",\r",
              "  properties: {\r",
              "    created_at: { type: \"string\" },\r",
              "    email: { type: \"string\", format: \"email\" },\r",
              "    id: { type: \"string\" },\r",
              "    name: { type: \"string\" },\r",
              "    read_only: { type: \"boolean\" },\r",
              "    status: { type: \"string\" },\r",
              "    updated_at: { type: \"string\" }\r",
              "  },\r",
              "  required: [\r",
              "    \"created_at\",\r",
              "    \"email\",\r",
              "    \"id\",\r",
              "    \"name\",\r",
              "    \"read_only\",\r",
              "    \"status\",\r",
              "    \"updated_at\"\r",
              "  ],\r",
              "  additionalProperties: false\r",
              "};\r",
              "\r",
              "pm.test(\"Response matches user schema\", function () {\r",
              "  pm.response.to.have.jsonSchema(schema);\r",
              "});\r",
              "pm.collectionVariables.set(\"userId\", responseJson.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "id": "9683ba02-8b4c-4167-8ce9-1af0720f130e",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
